---
import { type CollectionEntry, getCollection } from 'astro:content';
import SlopEntry from '../../../layouts/SlopEntry.astro';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { getLocalizedSlop, getSlopCopy } from '../../../i18n/content';
import { relatedSlops } from '../../../lib/related';

export async function getStaticPaths() {
	const slops = await getCollection('slops');
	const nonDefault = locales.filter((l) => l !== defaultLocale);
	return nonDefault.flatMap((lang) =>
		slops.map((slop) => ({
			params: { lang, slug: slop.id },
			props: { slop, locale: lang as Locale, all: slops },
		})),
	);
}

type Props = {
	slop: CollectionEntry<'slops'>;
	locale: Locale;
	all: CollectionEntry<'slops'>[];
};

const { slop, locale, all } = Astro.props;
const loc = getLocalizedSlop(
	slop.id,
	locale,
	{ description: slop.data.description, reason: slop.data.reason },
	slop.data.references,
);
const related = relatedSlops(slop, all, 3).map((entry) => {
	const copy = getSlopCopy(entry.id, locale, {
		description: entry.data.description,
		reason: entry.data.reason,
	});
	return {
		id: entry.id,
		name: entry.data.name,
		description: copy.description,
	};
});
---

<SlopEntry
	id={slop.id}
	locale={locale}
	{...slop.data}
	description={loc.description}
	reason={loc.reason}
	references={loc.references}
	related={related}
/>
