---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SlopEntry from '../../../layouts/SlopEntry.astro';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { getLocalizedSlop } from '../../../i18n/content';

export async function getStaticPaths() {
	const slops = await getCollection('slops');
	const nonDefault = locales.filter((l) => l !== defaultLocale);
	return nonDefault.flatMap((lang) =>
		slops.map((slop) => ({
			params: { lang, slug: slop.id },
			props: { slop, locale: lang as Locale },
		})),
	);
}

type Props = {
	slop: CollectionEntry<'slops'>;
	locale: Locale;
};

const { slop, locale } = Astro.props;
const { Content } = await render(slop);
const loc = getLocalizedSlop(
	slop.id,
	locale,
	{ description: slop.data.description, reason: slop.data.reason },
	slop.data.references,
);
---

<SlopEntry
	id={slop.id}
	locale={locale}
	{...slop.data}
	description={loc.description}
	reason={loc.reason}
	references={loc.references}
	bodyHtml={loc.bodyHtml}
	showBodyFallbackNote={!loc.hasLocalizedBody}
>
	{!loc.bodyHtml && <Content />}
</SlopEntry>
