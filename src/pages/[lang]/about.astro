---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { defaultLocale, localePath, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
	return locales
		.filter((l) => l !== defaultLocale)
		.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const siteUrl = Astro.site?.href ?? 'https://slop-watch.vercel.app/';
const aboutDescription = t(locale, 'aboutMetaDescription');
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: t(locale, 'aboutTitle'),
	description: aboutDescription,
	url: new URL(localePath(locale, '/about/'), siteUrl).href,
	inLanguage: locale,
	isPartOf: { '@type': 'WebSite', name: t(locale, 'siteTitle'), url: siteUrl },
};

const aboutH1: Record<Locale, string> = {
	en: 'About Slop Watch',
	zh: '关于 Slop Watch',
	de: 'Über Slop Watch',
	it: 'Info su Slop Watch',
	ja: 'Slop Watch について',
	ko: 'Slop Watch 소개',
	es: 'Acerca de Slop Watch',
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={t(locale, 'aboutTitle')}
			description={aboutDescription}
			locale={locale}
			path="/about/"
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header locale={locale} path="/about/" />
		<main class="about">
			<h1>{aboutH1[locale]}</h1>
			<p set:html={t(locale, 'aboutP1')} />
			<p set:html={t(locale, 'aboutP2')} />
			<p set:html={t(locale, 'aboutP3')} />
			<p set:html={t(locale, 'aboutP4')} />
		</main>
		<Footer locale={locale} />
		<style>
			.about h1 {
				margin-bottom: 0.55rem;
				font-size: 1.35rem;
			}
			.about p {
				font-size: 0.95rem;
				line-height: 1.45;
				margin-bottom: 0.65em;
				max-width: 42rem;
			}
		</style>
	</body>
</html>
