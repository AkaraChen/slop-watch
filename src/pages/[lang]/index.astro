---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CatalogList from '../../components/CatalogList.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { defaultLocale, localePath, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
	return locales
		.filter((l) => l !== defaultLocale)
		.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;

const slops = (await getCollection('slops'))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const siteUrl = Astro.site?.href ?? 'https://slop-watch.vercel.app/';
const siteTitle = t(locale, 'siteTitle');
const siteDescription = t(locale, 'siteDescription');
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: siteTitle,
		description: siteDescription,
		url: new URL(localePath(locale, '/'), siteUrl).href,
		inLanguage: locale,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: `${siteTitle} — ${t(locale, 'navCatalog')}`,
		description: siteDescription,
		url: new URL(localePath(locale, '/'), siteUrl).href,
		inLanguage: locale,
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: slops.length,
			itemListElement: slops.map((slop, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: new URL(localePath(locale, `/slops/${slop.id}/`), siteUrl).href,
				name: slop.data.name,
			})),
		},
	},
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`${siteTitle} — ${t(locale, 'siteTagline')}`}
			description={siteDescription}
			locale={locale}
			path="/"
			jsonLd={jsonLd}
		/>
		<style>
			.page-head {
				margin: 0 0 1.15rem;
			}
			.page-head h1 {
				margin: 0;
				font-size: 1.85rem;
			}
			@media (max-width: 720px) {
				.page-head h1 {
					font-size: 1.55rem;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} path="/" />
		<main>
			<section class="page-head">
				<h1>{t(locale, 'catalogHeading')}</h1>
			</section>
			<CatalogList locale={locale} slops={slops} />
		</main>
		<Footer locale={locale} />
	</body>
</html>
