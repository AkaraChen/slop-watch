---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Equal cards: newest catalog date first. No status pin / no first-item hero.
const slops = (await getCollection('slops'))
	.filter((entry) => entry.data.status !== 'archived')
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
			.intro {
				margin-bottom: 2rem;
			}
			.intro h1 {
				margin-bottom: 0.35rem;
			}
			.intro p {
				color: rgb(var(--gray));
				margin: 0;
				max-width: 42rem;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img.featured {
				margin-bottom: 0.75rem;
				border-radius: 12px;
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
			}
			ul li a.card {
				display: block;
				color: inherit;
			}
			.card-top {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 0.35rem;
			}
			.card-top img.icon {
				border-radius: 8px;
				flex-shrink: 0;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.date {
				margin: 0.15rem 0 0.4rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.desc {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
				font-size: 0.98rem;
			}
			.meta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 0.75rem;
				align-items: center;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.badge {
				display: inline-block;
				padding: 0.1rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.95);
				text-transform: uppercase;
				letter-spacing: 0.03em;
				font-size: 0.75rem;
			}
			.badge.featured {
				background: color-mix(in srgb, var(--accent) 18%, white);
				color: var(--accent-dark);
			}
			ul a.card:hover .title {
				color: var(--accent);
			}
			ul a.card:hover img.featured {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.25rem;
				}
				ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Catalog of AI Slop</h1>
				<p>
					{SITE_DESCRIPTION} Each entry has a name, icon, featured image, primary link,
					description, selection reason, and supporting references.
				</p>
			</section>
			<section>
				<ul>
					{
						slops.map((slop) => (
							<li>
								<a class="card" href={`/slops/${slop.id}/`}>
									<Image
										class="featured"
										width={720}
										height={360}
										src={slop.data.featuredImage}
										alt=""
									/>
									<div class="card-body">
										<div class="card-top">
											{slop.data.icon && (
												<Image
													class="icon"
													width={36}
													height={36}
													src={slop.data.icon}
													alt=""
												/>
											)}
											<h2 class="title">{slop.data.name}</h2>
										</div>
										<p class="date">
											<FormattedDate date={slop.data.publishedAt} />
										</p>
										<p class="desc">{slop.data.description}</p>
										<div class="meta-row">
											<span class:list={['badge', slop.data.status]}>
												{slop.data.status}
											</span>
											<span>{slop.data.references.length} references</span>
											{slop.data.tags.slice(0, 3).map((tag) => (
												<span>#{tag}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
