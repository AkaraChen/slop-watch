---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About Slop Watch</h1>
			<p>
				Slop Watch is a showcase catalog of AI Slop — generative mush that floods feeds,
				search results, and product surfaces. We publish named specimens so people can
				recognize patterns, not just complain abstractly.
			</p>
			<p>
				Entries are maintained with <strong>Astro Content Collections</strong>. Each slop
				record includes display assets (name, icon, featured image), a primary link,
				description, selection reason, and a list of references (links + short overviews).
			</p>
			<p>
				To add an entry, drop a Markdown/MDX file under <code>src/content/slops/</code> and
				fill the frontmatter schema in <code>src/content.config.ts</code>.
			</p>
		</main>
		<Footer />
	</body>
</html>
