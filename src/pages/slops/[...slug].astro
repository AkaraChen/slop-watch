---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SlopEntry from '../../layouts/SlopEntry.astro';
import { defaultLocale } from '../../i18n/config';
import { getLocalizedSlop } from '../../i18n/content';

export async function getStaticPaths() {
	const slops = await getCollection('slops');
	return slops.map((slop) => ({
		params: { slug: slop.id },
		props: slop,
	}));
}

type Props = CollectionEntry<'slops'>;

const locale = defaultLocale;
const slop = Astro.props;
const { Content } = await render(slop);
const loc = getLocalizedSlop(
	slop.id,
	locale,
	{ description: slop.data.description, reason: slop.data.reason },
	slop.data.references,
);
---

<SlopEntry
	id={slop.id}
	locale={locale}
	{...slop.data}
	description={loc.description}
	reason={loc.reason}
	references={loc.references}
	showBodyFallbackNote={false}
>
	<Content />
</SlopEntry>
