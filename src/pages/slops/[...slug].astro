---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SlopEntry from '../../layouts/SlopEntry.astro';
import { defaultLocale } from '../../i18n/config';
import { getLocalizedSlop, getSlopCopy } from '../../i18n/content';
import { relatedSlops } from '../../lib/related';

export async function getStaticPaths() {
	const slops = await getCollection('slops');
	return slops.map((slop) => ({
		params: { slug: slop.id },
		props: { slop, all: slops },
	}));
}

type Props = {
	slop: CollectionEntry<'slops'>;
	all: CollectionEntry<'slops'>[];
};

const locale = defaultLocale;
const { slop, all } = Astro.props;
const { Content } = await render(slop);
const loc = getLocalizedSlop(
	slop.id,
	locale,
	{ description: slop.data.description, reason: slop.data.reason },
	slop.data.references,
);
const related = relatedSlops(slop, all, 3).map((entry) => {
	const copy = getSlopCopy(entry.id, locale, {
		description: entry.data.description,
		reason: entry.data.reason,
	});
	return {
		id: entry.id,
		name: entry.data.name,
		description: copy.description,
	};
});
---

<SlopEntry
	id={slop.id}
	locale={locale}
	{...slop.data}
	description={loc.description}
	reason={loc.reason}
	references={loc.references}
	related={related}
	showBodyFallbackNote={false}
>
	<Content />
</SlopEntry>
