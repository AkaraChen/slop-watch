---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

type Props = Omit<CollectionEntry<'slops'>['data'], 'references' | 'description' | 'reason'> & {
	id: string;
	locale: Locale;
	description: string;
	reason: string;
	references: CollectionEntry<'slops'>['data']['references'];
	showBodyFallbackNote?: boolean;
	/** When set, used instead of default <slot /> body (localized HTML) */
	bodyHtml?: string;
};

const {
	id,
	locale,
	name,
	description,
	link,
	reason,
	featuredImage,
	icon,
	publishedAt,
	lastVerifiedAt,
	tags,
	status,
	references,
	showBodyFallbackNote = false,
	bodyHtml,
} = Astro.props;

const pageTitle = t(locale, 'specimenTitle', { name });
const metaDescription =
	description.length > 155 ? `${description.slice(0, 152).trimEnd()}…` : description;
const siteUrl = Astro.site?.href ?? 'https://slop-watch.vercel.app/';
const pagePath = `/slops/${id}/`;
const pageUrl = new URL(localePath(locale, pagePath), siteUrl).href;
const imageUrl = new URL(featuredImage.src, siteUrl).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: name,
	description,
	inLanguage: locale,
	image: [imageUrl],
	datePublished: publishedAt.toISOString(),
	mainEntityOfPage: pageUrl,
	author: { '@type': 'Organization', name: t(locale, 'siteTitle') },
	publisher: { '@type': 'Organization', name: t(locale, 'siteTitle'), url: siteUrl },
	about: {
		'@type': 'SoftwareApplication',
		name,
		url: link,
	},
	keywords: tags.join(', '),
};
---

<html lang={locale}>
	<head>
		<BaseHead
			title={pageTitle}
			description={metaDescription}
			locale={locale}
			path={pagePath}
			image={featuredImage}
			type="article"
			publishedAt={publishedAt}
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 1.15em 1em 2em;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 0.85rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 280px;
				object-fit: cover;
				border-radius: 10px;
				box-shadow: var(--box-shadow);
			}
			.header-block {
				margin-bottom: 1em;
			}
			.title-row {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 0.4rem;
			}
			.title-row h1 {
				margin: 0;
				font-size: 1.75rem;
				line-height: 1.15;
			}
			.icon {
				border-radius: 8px;
				flex-shrink: 0;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.7rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				margin-bottom: 0.65rem;
			}
			.badge {
				display: inline-block;
				padding: 0.1rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.9);
				color: rgb(var(--gray-dark));
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.badge.featured {
				background: color-mix(in srgb, var(--accent) 18%, white);
				color: var(--accent-dark);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
			}
			.tag {
				font-size: 0.78rem;
				padding: 0.08rem 0.4rem;
				border: 1px solid rgba(var(--gray), 0.35);
				border-radius: 5px;
				color: rgb(var(--gray));
			}
			.lead {
				font-size: 1.02rem;
				line-height: 1.5;
				margin: 0 0 0.55rem;
			}
			.panel {
				background: white;
				border: 1px solid rgba(var(--gray-light), 1);
				border-radius: 10px;
				padding: 0.9rem 1rem;
				margin: 0 0 0.9rem;
			}
			.panel h2 {
				font-size: 1.05rem;
				margin: 0 0 0.4rem;
			}
			.panel p {
				margin: 0;
				font-size: 0.98rem;
				line-height: 1.5;
			}
			.verified {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				align-items: center;
			}
			.copy-link {
				font: inherit;
				font-size: 0.9rem;
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				border: 1px solid rgba(var(--gray), 0.35);
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
			}
			.copy-link:hover,
			.copy-link:focus-visible {
				border-color: var(--accent);
				outline: none;
			}
			.external {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-weight: 700;
				font-size: 0.95rem;
			}
			.references {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.55rem;
			}
			.references li {
				border-top: 1px solid rgba(var(--gray-light), 1);
				padding-top: 0.5rem;
			}
			.references li:first-child {
				border-top: none;
				padding-top: 0;
			}
			.references h3 {
				font-size: 0.95rem;
				margin: 0 0 0.15rem;
			}
			.references .summary {
				margin: 0.2rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.88rem;
				line-height: 1.4;
			}
			.ref-meta {
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			.fallback-note {
				font-size: 0.82rem;
				color: rgb(var(--gray));
				font-style: italic;
				margin: 0 0 0.65rem;
			}
			.prose-body {
				font-size: 0.92rem;
				line-height: 1.45;
			}
			hr {
				border: none;
				border-top: 1px solid rgba(var(--gray-light), 1);
				margin: 0.85rem 0;
			}
		</style>
	</head>
	<body>
		<Header locale={locale} path={pagePath} />
		<main>
			<article>
				<div class="hero-image">
					<Image
						width={720}
						height={360}
						src={featuredImage}
						alt={t(locale, 'featuredImageAlt', { name })}
					/>
				</div>
				<div class="header-block">
					<div class="title-row">
						{icon && <Image class="icon" width={36} height={36} src={icon} alt="" />}
						<h1>{name}</h1>
					</div>
					<div class="meta">
						<span class:list={['badge', status]}>{status}</span>
						<span><FormattedDate date={publishedAt} locale={locale} /></span>
						{
							lastVerifiedAt && (
								<span class="verified">
									{t(locale, 'lastVerified', {
										date: lastVerifiedAt.toLocaleDateString(undefined, {
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										}),
									})}
								</span>
							)
						}
						{
							tags.length > 0 && (
								<span class="tags">
									{tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</span>
							)
						}
					</div>
					<p class="lead">{description}</p>
					<p class="actions">
						<a class="external" href={link} target="_blank" rel="noopener noreferrer">
							{t(locale, 'openPrimaryLink')}
						</a>
						<button type="button" class="copy-link" data-url={pageUrl} data-copied={t(locale, 'copied')}>
							{t(locale, 'copyLink')}
						</button>
					</p>
				</div>

				<section class="panel">
					<h2>{t(locale, 'whyListed')}</h2>
					<p>{reason}</p>
				</section>

				{
					references.length > 0 && (
						<section class="panel">
							<h2>{t(locale, 'referencesHeading', { n: references.length })}</h2>
							<ul class="references">
								{references.map((ref) => (
									<li>
										<h3>
											<a href={ref.url} target="_blank" rel="noopener noreferrer">
												{ref.title}
											</a>
										</h3>
										<div class="ref-meta">
											{ref.source && <span>{ref.source}</span>}
											{ref.source && ref.publishedAt && <span> · </span>}
											{ref.publishedAt && (
												<FormattedDate date={ref.publishedAt} locale={locale} />
											)}
										</div>
										<p class="summary">{ref.summary}</p>
									</li>
								))}
							</ul>
						</section>
					)
				}

				<hr />
				{showBodyFallbackNote && !bodyHtml && (
					<p class="fallback-note">{t(locale, 'bodyFallbackNote')}</p>
				)}
				<div class="prose-body">
					{bodyHtml ? <div class="localized-body" set:html={bodyHtml} /> : <slot />}
				</div>
			</article>
		</main>
		<Footer locale={locale} />
		<script is:inline>
			document.querySelectorAll('button.copy-link').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const url = btn.getAttribute('data-url') || location.href;
					const done = btn.getAttribute('data-copied') || 'Copied';
					const prev = btn.textContent;
					try {
						await navigator.clipboard.writeText(url);
						btn.textContent = done;
						setTimeout(() => { btn.textContent = prev; }, 1500);
					} catch {
						/* ignore */
					}
				});
			});
		</script>
	</body>
</html>
