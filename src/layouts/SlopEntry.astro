---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'slops'>['data'] & { id: string };

const {
	id,
	name,
	description,
	link,
	reason,
	featuredImage,
	icon,
	publishedAt,
	tags,
	status,
	references,
} = Astro.props;

const pageTitle = `${name} · AI Slop specimen · ${SITE_TITLE}`;
const metaDescription =
	description.length > 155 ? `${description.slice(0, 152).trimEnd()}…` : description;
const siteUrl = Astro.site?.href ?? 'https://slop-watch.vercel.app/';
const pageUrl = new URL(`/slops/${id}/`, siteUrl).href;
const imageUrl = new URL(featuredImage.src, siteUrl).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: name,
	description,
	image: [imageUrl],
	datePublished: publishedAt.toISOString(),
	mainEntityOfPage: pageUrl,
	author: { '@type': 'Organization', name: SITE_TITLE },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: siteUrl },
	about: {
		'@type': 'SoftwareApplication',
		name,
		url: link,
	},
	keywords: tags.join(', '),
};
---

<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={metaDescription}
			image={featuredImage}
			type="article"
			publishedAt={publishedAt}
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.header-block {
				margin-bottom: 1.5em;
				padding: 1em 0 0.5em;
			}
			.title-row {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.5rem;
			}
			.title-row h1 {
				margin: 0;
				line-height: 1.15;
			}
			.icon {
				border-radius: 10px;
				flex-shrink: 0;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin-bottom: 1rem;
			}
			.badge {
				display: inline-block;
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.9);
				color: rgb(var(--gray-dark));
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}
			.badge.featured {
				background: color-mix(in srgb, var(--accent) 18%, white);
				color: var(--accent-dark);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.tag {
				font-size: 0.8rem;
				padding: 0.1rem 0.5rem;
				border: 1px solid rgba(var(--gray), 0.35);
				border-radius: 6px;
				color: rgb(var(--gray));
			}
			.lead {
				font-size: 1.15rem;
				margin: 0 0 1rem;
			}
			.panel {
				background: white;
				border: 1px solid rgba(var(--gray-light), 1);
				border-radius: 12px;
				padding: 1rem 1.15rem;
				margin: 0 0 1.25rem;
				box-shadow: 0 1px 0 rgba(var(--black), 3%);
			}
			.panel h2 {
				font-size: 1.15rem;
				margin: 0 0 0.5rem;
			}
			.panel p {
				margin: 0;
			}
			.external {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-weight: 700;
			}
			.references {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1rem;
			}
			.references li {
				border-top: 1px solid rgba(var(--gray-light), 1);
				padding-top: 0.85rem;
			}
			.references li:first-child {
				border-top: none;
				padding-top: 0;
			}
			.references h3 {
				font-size: 1.05rem;
				margin: 0 0 0.25rem;
			}
			.references .summary {
				margin: 0.35rem 0 0;
				color: rgb(var(--gray-dark));
			}
			.ref-meta {
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			hr {
				border: none;
				border-top: 1px solid rgba(var(--gray-light), 1);
				margin: 1.5rem 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					<Image width={1020} height={510} src={featuredImage} alt={`Featured image for ${name}`} />
				</div>
				<div class="prose">
					<div class="header-block">
						<div class="title-row">
							{
								icon && (
									<Image class="icon" width={56} height={56} src={icon} alt="" />
								)
							}
							<h1>{name}</h1>
						</div>
						<div class="meta">
							<span class:list={['badge', status]}>{status}</span>
							<span><FormattedDate date={publishedAt} /></span>
							{
								tags.length > 0 && (
									<span class="tags">
										{tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</span>
								)
							}
						</div>
						<p class="lead">{description}</p>
						<p>
							<a class="external" href={link} target="_blank" rel="noopener noreferrer">
								Open primary link ↗
							</a>
						</p>
					</div>

					<section class="panel">
						<h2>Why it made the list</h2>
						<p>{reason}</p>
					</section>

					{
						references.length > 0 && (
							<section class="panel">
								<h2>References ({references.length})</h2>
								<ul class="references">
									{references.map((ref) => (
										<li>
											<h3>
												<a href={ref.url} target="_blank" rel="noopener noreferrer">
													{ref.title}
												</a>
											</h3>
											<div class="ref-meta">
												{ref.source && <span>{ref.source}</span>}
												{ref.source && ref.publishedAt && <span> · </span>}
												{ref.publishedAt && <FormattedDate date={ref.publishedAt} />}
											</div>
											<p class="summary">{ref.summary}</p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<hr />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
