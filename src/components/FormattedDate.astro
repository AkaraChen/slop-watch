---
import { dateLocales, type Locale } from '../i18n/config';

interface Props {
	date: Date;
	locale?: Locale;
}

const { date, locale = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(dateLocales[locale], {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
