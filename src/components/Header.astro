---
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderLink from './HeaderLink.astro';
import { localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
	locale: Locale;
	path?: string;
}

const { locale, path = '/' } = Astro.props;
const title = t(locale, 'siteTitle');
---

<header>
	<nav>
		<h2><a href={localePath(locale, '/')}>{title}</a></h2>
		<div class="internal-links">
			<HeaderLink href={localePath(locale, '/')}>{t(locale, 'navCatalog')}</HeaderLink>
			<HeaderLink href={localePath(locale, '/about/')}>{t(locale, 'navAbout')}</HeaderLink>
		</div>
		<div class="end">
			<label class="theme sr-only" for="theme-select">{t(locale, 'theme')}</label>
			<select id="theme-select" name="theme" aria-label={t(locale, 'theme')}>
				<option value="system">{t(locale, 'themeSystem')}</option>
				<option value="light">{t(locale, 'themeLight')}</option>
				<option value="dark">{t(locale, 'themeDark')}</option>
			</select>
			<LanguageSwitcher locale={locale} path={path} />
			<div class="social-links">
				<a href="https://github.com/AkaraChen/slop-watch" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">GitHub repository</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
	<script is:inline>
		(function () {
			const key = 'slop-watch-theme';
			const root = document.documentElement;
			const select = document.getElementById('theme-select');
			function apply(mode) {
				if (mode === 'light' || mode === 'dark') {
					root.setAttribute('data-theme', mode);
				} else {
					root.removeAttribute('data-theme');
					mode = 'system';
				}
				try {
					localStorage.setItem(key, mode);
				} catch (_) {}
				if (select) select.value = mode;
			}
			let initial = 'system';
			try {
				initial = localStorage.getItem(key) || 'system';
			} catch (_) {}
			apply(initial);
			if (select) {
				select.addEventListener('change', () => apply(select.value));
			}
		})();
	</script>
</header>
<style>
	header {
		margin: 0;
		padding: 0 0.65em;
		background: white;
		box-shadow: 0 1px 5px rgba(var(--black), 6%);
		max-width: 100%;
		overflow-x: clip;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		min-width: 0;
		flex: 0 1 auto;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		flex-wrap: wrap;
		padding: 0.3rem 0;
		max-width: 100%;
		min-width: 0;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		min-width: 0;
	}
	nav a {
		padding: 0.45em 0.35em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.92em;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.end {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		min-width: 0;
		max-width: 100%;
	}
	#theme-select {
		font: inherit;
		font-size: 0.75rem;
		padding: 0.2rem 0.3rem;
		border-radius: 6px;
		border: 1px solid rgba(var(--gray), 0.35);
		background: transparent;
		color: inherit;
		max-width: 6.5rem;
		min-width: 0;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			gap: 0.3rem;
		}
		#theme-select {
			max-width: 5.75rem;
			font-size: 0.7rem;
		}
	}
</style>
