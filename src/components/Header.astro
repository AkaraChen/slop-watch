---
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderLink from './HeaderLink.astro';
import { localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
	locale: Locale;
	path?: string;
}

const { locale, path = '/' } = Astro.props;
const title = t(locale, 'siteTitle');
---

<header>
	<nav>
		<h2><a href={localePath(locale, '/')}>{title}</a></h2>
		<div class="internal-links">
			<HeaderLink href={localePath(locale, '/')}>{t(locale, 'navCatalog')}</HeaderLink>
			<HeaderLink href={localePath(locale, '/about/')}>{t(locale, 'navAbout')}</HeaderLink>
			<HeaderLink href={localePath(locale, '/standards/')}>{t(locale, 'navStandards')}</HeaderLink>
		</div>
		<div class="end">
			<button
				type="button"
				id="theme-toggle"
				class="theme-toggle"
				aria-label={t(locale, 'theme')}
				data-label-light={t(locale, 'themeLight')}
				data-label-dark={t(locale, 'themeDark')}
				data-label-system={t(locale, 'themeSystem')}
				data-label-theme={t(locale, 'theme')}
			>
				<span class="theme-icon" data-mode="light" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg
					>
				</span>
				<span class="theme-icon" data-mode="dark" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path></svg
					>
				</span>
				<span class="theme-icon" data-mode="system" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg
					>
				</span>
			</button>
			<LanguageSwitcher locale={locale} path={path} />
			<div class="social-links">
				<a href="https://github.com/AkaraChen/slop-watch" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">GitHub repository</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
	<script is:inline>
		(function () {
			const key = 'slop-watch-theme';
			const order = ['light', 'dark', 'system'];
			const root = document.documentElement;
			const btn = document.getElementById('theme-toggle');

			function normalize(mode) {
				return mode === 'light' || mode === 'dark' || mode === 'system' ? mode : 'system';
			}

			function labelFor(mode) {
				if (!btn) return mode;
				if (mode === 'light') return btn.getAttribute('data-label-light') || mode;
				if (mode === 'dark') return btn.getAttribute('data-label-dark') || mode;
				return btn.getAttribute('data-label-system') || mode;
			}

			function apply(mode) {
				mode = normalize(mode);
				if (mode === 'light' || mode === 'dark') {
					root.setAttribute('data-theme', mode);
				} else {
					root.removeAttribute('data-theme');
				}
				try {
					localStorage.setItem(key, mode);
				} catch (_) {}
				if (!btn) return;
				btn.dataset.theme = mode;
				btn.querySelectorAll('.theme-icon').forEach(function (el) {
					el.hidden = el.getAttribute('data-mode') !== mode;
				});
				var themeWord = btn.getAttribute('data-label-theme') || 'Theme';
				var current = labelFor(mode);
				var next = labelFor(order[(order.indexOf(mode) + 1) % order.length]);
				btn.setAttribute('aria-label', themeWord + ': ' + current);
				btn.setAttribute('title', current + ' → ' + next);
			}

			var initial = 'system';
			try {
				initial = localStorage.getItem(key) || 'system';
			} catch (_) {}
			apply(initial);

			if (btn) {
				btn.addEventListener('click', function () {
					var cur = normalize(btn.dataset.theme || 'system');
					var next = order[(order.indexOf(cur) + 1) % order.length];
					apply(next);
				});
			}
		})();
	</script>
</header>
<style>
	header {
		margin: 0;
		padding: 0 0.65em;
		background: white;
		box-shadow: 0 1px 5px rgba(var(--black), 6%);
		max-width: 100%;
		overflow-x: clip;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		min-width: 0;
		flex: 0 1 auto;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		flex-wrap: wrap;
		padding: 0.3rem 0;
		max-width: 100%;
		min-width: 0;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		min-width: 0;
	}
	nav a {
		padding: 0.45em 0.35em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.92em;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.end {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		min-width: 0;
		max-width: 100%;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border-radius: 8px;
		border: 1px solid rgba(var(--gray), 0.35);
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
		cursor: pointer;
		flex-shrink: 0;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.theme-toggle .theme-icon {
		display: inline-flex;
		line-height: 0;
	}
	.theme-toggle .theme-icon[hidden] {
		display: none;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			gap: 0.3rem;
		}
	}
</style>
