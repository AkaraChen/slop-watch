---
import { localeLabels, localePath, locales, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
	locale: Locale;
	/** Path without locale prefix, e.g. `/` or `/slops/openclaw/` */
	path: string;
}

const { locale, path } = Astro.props;

const options = locales.map((code) => ({
	code,
	label: localeLabels[code],
	href: localePath(code, path),
}));
---

<div class="lang-switch">
	<label class="sr-only" for="lang-select">{t(locale, 'language')}</label>
	<select
		id="lang-select"
		name="language"
		aria-label={t(locale, 'language')}
		onchange="if (this.value) window.location.href = this.value"
	>
		{
			options.map((opt) => (
				<option value={opt.href} selected={opt.code === locale}>
					{opt.label}
				</option>
			))
		}
	</select>
</div>
<style>
	.lang-switch {
		display: flex;
		align-items: center;
	}
	select {
		font: inherit;
		font-size: 0.8rem;
		padding: 0.25rem 1.5rem 0.25rem 0.45rem;
		border: 1px solid rgba(var(--gray), 0.35);
		border-radius: 8px;
		/* Theme tokens only — no hardcoded white (breaks dark mode contrast) */
		background-color: rgb(var(--gray-light));
		background-image: linear-gradient(45deg, transparent 50%, rgb(var(--gray)) 50%),
			linear-gradient(135deg, rgb(var(--gray)) 50%, transparent 50%);
		background-position:
			calc(100% - 12px) calc(50% - 2px),
			calc(100% - 7px) calc(50% - 2px);
		background-size:
			5px 5px,
			5px 5px;
		background-repeat: no-repeat;
		color: rgb(var(--black));
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
		min-width: 0;
		max-width: 8.5rem;
		width: auto;
	}
	select option {
		background-color: rgb(var(--gray-light));
		color: rgb(var(--black));
	}
	@media (max-width: 720px) {
		select {
			max-width: 6.75rem;
			font-size: 0.72rem;
			padding-right: 1.25rem;
		}
	}
	select:hover,
	select:focus {
		border-color: var(--accent);
		outline: none;
	}
</style>
