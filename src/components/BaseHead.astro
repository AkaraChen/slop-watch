---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { Font } from 'astro:assets';
import { defaultLocale, locales, localePath, ogLocales, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	/** Path without locale prefix */
	path?: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedAt?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	locale,
	path = '/',
	image = FallbackImage,
	type = 'website',
	publishedAt,
	jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://slop-watch.vercel.app');
const canonicalURL = new URL(localePath(locale, path), site);
const ogImage = new URL(image.src, site);
const absolutePageUrl = canonicalURL.href;
const jsonLdPayload = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : null;
const siteTitle = t(locale, 'siteTitle');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta name="theme-color" content="#111111" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteTitle}
	href={new URL('rss.xml', site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />
{
	locales.map((code) => (
		<link rel="alternate" hreflang={code} href={new URL(localePath(code, path), site).href} />
	))
}
<link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, path), site).href} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={siteTitle} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocales[locale]} />
<meta property="og:url" content={absolutePageUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
	jsonLdPayload &&
		jsonLdPayload.map((item) => (
			<script type="application/ld+json" set:html={JSON.stringify(item)} />
		))
}
