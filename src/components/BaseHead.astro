---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { defaultLocale, locales, localePath, ogLocales, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	/** Path without locale prefix */
	path?: string;
	/** Specimen/feature image; when omitted, site default OG illustration is used */
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedAt?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	locale,
	path = '/',
	image,
	type = 'website',
	publishedAt,
	jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://slop-watch.akr.moe');
const canonicalURL = new URL(localePath(locale, path), site);
const absolutePageUrl = canonicalURL.href;
const jsonLdPayload = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : null;
const siteTitle = t(locale, 'siteTitle');

/** Prefer clean Markdown mirrors for AI crawlers (GEO). */
function markdownAlternateHref(locale: Locale, path: string): string | null {
	const clean = path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path;
	// Specimen: /slops/{id}/ → /slops/{id}.md (en) or /{locale}/slops/{id}.md
	const specimen = clean.match(/^\/slops\/([^/]+)$/);
	if (specimen) {
		const file = `/slops/${specimen[1]}.md`;
		return new URL(locale === 'en' ? file : `/${locale}${file}`, site).href;
	}
	// Home, about, standards (en + zh home only for now)
	if (clean === '/' || clean === '') {
		return new URL(locale === 'en' ? '/index.md' : `/${locale}/index.md`, site).href;
	}
	if (clean === '/about' || clean === '/standards') {
		if (locale !== 'en') return null;
		return new URL(`${clean}.md`, site).href;
	}
	return null;
}
const markdownAlternate = markdownAlternateHref(locale, path);

/** SERP-safe meta length (UTF-16 code units ≈ display budget for most engines). */
function clampMeta(text: string, max = 155): string {
	const normalized = text.replace(/\s+/g, ' ').trim();
	if (normalized.length <= max) return normalized;
	const cut = normalized.slice(0, max - 1);
	const soft = cut.replace(/\s+\S*$/, '');
	return `${(soft.length >= 40 ? soft : cut).trimEnd()}…`;
}

// Leave headroom for HTML entity expansion (e.g. quotes → &quot;) in attributes.
const metaDescription = clampMeta(description.replace(/[“”"']/g, ''), 155);
const metaTitle = clampMeta(title, 70);

// Site-wide default OG illustration (public/og-default.jpg, 1200×630, no text).
const defaultOg = {
	url: new URL('/og-default.jpg', site).href,
	width: 1200,
	height: 630,
	type: 'image/jpeg',
	alt: t(locale, 'siteTitle'),
};

const ogImage = image
	? {
			url: new URL(image.src, site).href,
			width: image.width,
			height: image.height,
			type: image.format === 'svg' ? 'image/svg+xml' : `image/${image.format}`,
			alt: metaTitle,
		}
	: defaultOg;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta name="theme-color" content="#111111" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" title="llms.txt" href={new URL('/llms.txt', site).href} />
{markdownAlternate && (
	<link rel="alternate" type="text/markdown" title="Markdown" href={markdownAlternate} />
)}
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteTitle}
	href={new URL('rss.xml', site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />
{
	locales.map((code) => (
		<link rel="alternate" hreflang={code} href={new URL(localePath(code, path), site).href} />
	))
}
<link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, path), site).href} />

<title>{title}</title>
<meta name="description" content={metaDescription} />
<meta name="author" content={siteTitle} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocales[locale]} />
{
	locales
		.filter((code) => code !== locale)
		.map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
}
<meta property="og:url" content={absolutePageUrl} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:secure_url" content={ogImage.url} />
<meta property="og:image:type" content={ogImage.type} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={ogImage.alt} />

{
	jsonLdPayload &&
		jsonLdPayload.map((item) => (
			<script type="application/ld+json" set:html={JSON.stringify(item)} />
		))
}
